{
  "$schema": "../node_modules/@lobehub/chat-plugin-sdk/schema.json",
  "api": [
    {
      "name": "CodeExecutor",
      "url": "https://code-exec-plugin.vercel.app/api/v2",
      "description": "执行Python代码并返回结果，支持数据分析和可视化",
      "parameters": {
        "properties": {
          "code": {
            "description": "需要执行的代码",
            "type": "string"
          },
          "language": {
            "description": "代码语言，默认为Python",
            "type": "string",
            "enum": ["python"]
          }
        },
        "required": ["code"],
        "type": "object"
      }
    }
  ],
  "settings": {
    "type": "object",
    "required": ["E2B_API_KEY"],
    "properties": {
      "E2B_API_KEY": {
        "title": "E2B API Key",
        "description": "该插件使用 E2B 作为代码执行环境, 需要提供 E2B API Key",
        "type": "string",
        "format": "password"
      }
    }
  },
  "ui": {
    "url": "https://code-exec-plugin.vercel.app/ui",
    "height": 500
  },
  "author": "ZWL_FineHow",
  "createdAt": "2024-11-21",
  "homepage": "https://github.com/FineHow/CodeExec-Plugin",
  "identifier": "CodeExec",
  "meta": {
    "avatar": "💻",
    "tags": ["Code", "Python", "Data Analysis"],
    "title": "代码执行助手",
    "description": "执行Python代码并返回结果，支持数据分析和可视化"
  },
  "version": "1"
}
