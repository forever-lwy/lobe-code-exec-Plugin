{
  "name": "code-execution-plugin",
  "version": "1.0.0",
  "private": true,
  "description": "This is a code execution plugin for LobeChat using E2B",
  "homepage": "https://github.com/FineHow/CodeExec-Plugin",
  "repository": "https://github.com/FineHow/CodeExec-Plugin.git",
  "workspaces": [
    "docs/*",
    "./*"
  ],
  "scripts": {
    "build": "next build",
    "ci": "npm run lint && npm run type-check",
    "dev": "next dev -p 3400",
    "docs:build": "cd docs && npm run build",
    "docs:dev": "cd docs && npm run dev",
    "install:dev": "npm install",
    "install:prod": "npm install --omit=dev",
    "lint": "eslint \"{src,api,docs}/**/*.{js,jsx,ts,tsx}\" --fix",
    "prepublishOnly": "npm run build",
    "start": "next start",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@e2b/code-interpreter": "^1.0.4",
    "dayjs": "^1",
    "dotenv": "^16.0.0",
    "next": "13.4.7",
    "react": "^18",
    "react-dom": "^18",
    "react-layout-kit": "^1"
  },
  "devDependencies": {
    "@types/react": "18",
    "eslint": "^8",
    "prettier": "^3",
    "typescript": "^5"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
